<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".activity.fragments.HomeFragment">

    <!-- Overview Cards -->

    <LinearLayout
        android:id="@+id/overview_cards_scrollview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">



        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_background"
            android:elevation="4dp"
            android:layout_gravity="center"
            android:minWidth="150dp"
            android:minHeight="100dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Books"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/fh_tv_book_stock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Stocks"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#009688"
                android:paddingTop="4dp" />
        </LinearLayout>

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_background"
            android:elevation="4dp"
            android:layout_gravity="center"
            android:minWidth="150dp"
            android:minHeight="100dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Orders Summary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/fh_tv_orders_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Orders"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FF9800"
                android:paddingTop="4dp" />
        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:id="@+id/overview_cards_scrollview1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/overview_cards_scrollview">

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/card_background"
            android:elevation="4dp"
            android:layout_gravity="center"
            android:minWidth="150dp"
            android:minHeight="100dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Earnings"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/fh_tv_earnings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:paddingTop="4dp" />
        </LinearLayout>


        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/card_background"
            android:elevation="4dp"
            android:layout_gravity="center"
            android:minWidth="150dp"
            android:minHeight="100dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Low Stock"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/fh_tv_low_stock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Items"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#F44336"
                android:paddingTop="4dp" />
        </LinearLayout>


    </LinearLayout>


    <!-- Sales Analytics Chart -->
    <LinearLayout
        android:id="@+id/sales_analytics_layout"
        android:layout_width="0dp"
        android:layout_height="300dp"
        android:background="@drawable/card_background"
        android:orientation="vertical"
        android:layout_margin="12dp"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/overview_cards_scrollview1">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sales Analytics"
            android:layout_margin="8dp"
            android:textSize="18sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/chart_container"
            android:layout_margin="8dp"
            android:layout_width="match_parent"
            android:layout_height="225dp" >

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/fh_line_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>
    </LinearLayout>

    <!-- Recent Orders -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recent_orders_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/card_background"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sales_analytics_layout">

        <TextView
            android:id="@+id/recent_orders_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recent Orders"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recent_orders_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/recent_orders_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- Quick Actions -->
</androidx.constraintlayout.widget.ConstraintLayout>